<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" Condition="'$(RecipeSource)' == ''" />
    <Compile Include="..\ChartForgeX.Examples\ExampleRecipeImports.cs" Link="RecipeImports.cs" Condition="'$(RecipeSource)' == ''" />
    <Compile Include="..\ChartForgeX.Examples\ExampleRecipes.cs" Link="ExampleRecipes.cs" Condition="'$(RecipeSource)' == ''" />
    <Compile Include="..\ChartForgeX.Examples\Recipes\*Recipe.cs" Link="Recipes\%(Filename)%(Extension)" Condition="'$(RecipeSource)' == ''" />
    <Compile Include="$(RecipeSource)" Link="Program.cs" Condition="'$(RecipeSource)' != ''" />
    <ProjectReference Include="..\ChartForgeX\ChartForgeX.csproj" />
  </ItemGroup>
</Project>
