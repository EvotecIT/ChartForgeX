{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.release-validation.schema.json",
  "SchemaVersion": 1,
  "ProjectRoot": "../..",
  "Packages": {
    "Path": "{PackageRoot}",
    "ExactSet": false,
    "SameVersion": true,
    "VerifySignatures": false,
    "Items": [
      {
        "Id": "ChartForgeX"
      }
    ]
  },
  "Consumers": [
    {
      "SourceDirectory": "{CompileRoot}",
      "ProjectFile": "Core/CorePackageProbe.csproj",
      "Frameworks": [
        "net8.0",
        "net10.0"
      ],
      "WindowsFrameworks": [
        "net472"
      ],
      "DependencySources": [
        "https://api.nuget.org/v3/index.json"
      ]
    }
  ],
  "Commands": [
    {
      "Name": "Compile Core package consumer (netstandard2.0)",
      "FileName": "dotnet",
      "Arguments": [
        "build",
        "{CompileRoot}/Core/CorePackageProbe.csproj",
        "--framework",
        "netstandard2.0",
        "--configuration",
        "Release",
        "--nologo",
        "-p:PackageVersion={Version}",
        "-p:RestoreConfigFile={CompileRoot}/NuGet.Config",
        "-p:RestorePackagesPath={CompileRoot}/packages"
      ],
      "WorkingDirectory": "{CompileRoot}",
      "TimeoutSeconds": 600
    },
    {
      "Name": "Compile complete ordered filters example against Core package",
      "FileName": "dotnet",
      "Arguments": [
        "build",
        "{CompileRoot}/Core/CorePackageProbe.csproj",
        "--framework",
        "net8.0",
        "--configuration",
        "Release",
        "--nologo",
        "-p:PackageVersion={Version}",
        "-p:RestoreConfigFile={CompileRoot}/NuGet.Config",
        "-p:RestorePackagesPath={CompileRoot}/packages",
        "-p:RecipeSource={ProjectRoot}/ChartForgeX.Examples/Snippets/RecipeOrderedFiltersProgram.cs.txt"
      ],
      "WorkingDirectory": "{CompileRoot}",
      "TimeoutSeconds": 600
    },
    {
      "Name": "Run complete ordered filters package example",
      "FileName": "dotnet",
      "Arguments": [
        "{CompileRoot}/Core/bin/Release/net8.0/CorePackageProbe.dll"
      ],
      "WorkingDirectory": "{CompileRoot}",
      "TimeoutSeconds": 600
    },
    {
      "Name": "Compile complete color source example against Core package",
      "FileName": "dotnet",
      "Arguments": [
        "build",
        "{CompileRoot}/Core/CorePackageProbe.csproj",
        "--framework",
        "net8.0",
        "--configuration",
        "Release",
        "--nologo",
        "-p:PackageVersion={Version}",
        "-p:RestoreConfigFile={CompileRoot}/NuGet.Config",
        "-p:RestorePackagesPath={CompileRoot}/packages",
        "-p:RecipeSource={ProjectRoot}/ChartForgeX.Examples/Snippets/RecipeColorSourceProgram.cs.txt"
      ],
      "WorkingDirectory": "{CompileRoot}",
      "TimeoutSeconds": 600
    },
    {
      "Name": "Run complete color source package example",
      "FileName": "dotnet",
      "Arguments": [
        "{CompileRoot}/Core/bin/Release/net8.0/CorePackageProbe.dll"
      ],
      "WorkingDirectory": "{CompileRoot}",
      "TimeoutSeconds": 600
    }
  ]
}
