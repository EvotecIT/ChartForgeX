<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <DefineConstants>$(DefineConstants);CFX_PACKAGE_BROWSER</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PackageAssertions.cs" Link="PackageAssertions.cs" />
    <Compile Include="../PackageBrowserProbe.cs" Link="PackageBrowserProbe.cs" />
    <PackageReference Include="ChartForgeX" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Interactivity" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Interactivity.Html" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Markup" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Mermaid" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Markup.Mermaid" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Visuals" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="HtmlTinkerX" Version="3.0.5" PrivateAssets="all" />
  </ItemGroup>
</Project>
