<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PackageAssertions.cs" Link="PackageAssertions.cs" />
    <Compile Include="../PackageBrowserProbe.cs" Link="PackageBrowserProbe.cs" />
    <PackageReference Include="ChartForgeX" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Interactivity" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="ChartForgeX.Interactivity.Html" Version="$(PackageVersion)" PrivateAssets="all" />
    <PackageReference Include="OfficeIMO.ChartForgeX" Version="3.5.1" PrivateAssets="all" />
    <PackageReference Include="HtmlForgeX.ChartForgeX" Version="3.0.0" PrivateAssets="all" />
    <PackageReference Include="HtmlTinkerX" Version="3.0.5" PrivateAssets="all" />
  </ItemGroup>
</Project>
