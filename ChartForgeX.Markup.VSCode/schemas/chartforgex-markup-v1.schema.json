{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EvotecIT/ChartForgeX/schemas/chartforgex-markup-v1.schema.json",
  "name": "ChartForgeX Markup v1",
  "version": 1,
  "description": "Machine-readable contract for versioned ChartForgeX visual fenced blocks. This file describes the v1 grammar surface for editor tooling; parsers remain the source of runtime validation.",
  "canonicalFence": "chartforgex <kind> v1",
  "fenceMarkers": [
    "```",
    "~~~"
  ],
  "fenceAttributes": {
    "id": "Optional shorthand id, written as {#id}.",
    "class": "Optional class shorthand, written as {.class}.",
    "keyValue": "Optional key/value attributes inside the opening fence, such as title=\"Trend\" width=720 height=420."
  },
  "commonCommands": {
    "id": {
      "args": [
        "id"
      ]
    },
    "title": {
      "args": [
        "text"
      ]
    },
    "subtitle": {
      "args": [
        "text"
      ]
    },
    "size": {
      "args": [
        "WIDTHxHEIGHT"
      ]
    },
    "viewport": {
      "args": [
        "WIDTHxHEIGHT",
        "padding?"
      ]
    }
  },
  "supportedFences": [
    {
      "kind": "chart",
      "fence": "chartforgex chart v1",
      "artifactKind": "Chart",
      "model": "Chart",
      "commands": [
        "id",
        "title",
        "subtitle",
        "type",
        "size",
        "labels",
        "values",
        "value",
        "series",
        "candle",
        "item",
        "node",
        "flow",
        "annotation",
        "option",
        "theme",
        "themeMode",
        "gaugeMinimum",
        "gaugeMaximum",
        "end"
      ],
      "sections": [
        {
          "name": "options",
          "columns": [
            "key",
            "value"
          ]
        },
        { "name": "candles", "columns": ["x", "open", "high", "low", "close"] },
        { "name": "items", "columns": ["id", "label", "parent", "value", "colorValue"] },
        { "name": "nodes", "columns": ["id", "label"] },
        { "name": "flows", "columns": ["id", "source", "target", "value", "colorValue"] }
      ],
      "enumValues": {
        "type": [
          "bar", "column", "horizontalbar", "hbar", "stackedbar", "stackedhorizontalbar",
          "percentstackedbar", "percentstackedhorizontalbar", "line", "smoothline", "stepline",
          "area", "smootharea", "steparea", "stackedarea", "smoothstackedarea",
          "percentstackedarea", "smoothpercentstackedarea", "scatter", "lollipop", "dumbbell",
          "waterfall", "pie", "donut", "polar", "polararea", "radar", "funnel", "pyramid",
          "heatmap", "gauge", "lineargauge", "candlestick", "ohlc", "treemap", "sankey", "chord"
        ],
        "theme": [
          "Graphite", "Report", "Executive", "Product", "Accessible", "Colorblind", "Aurora",
          "Editorial", "Candy", "PeopleInfographic", "Terminal", "TransparentOverlay", "Minimal",
          "Dashboard", "SaasDashboard", "RestaurantDashboard", "light", "dark"
        ],
        "themeMode": ["light", "dark"]
      },
      "fenceAttributes": {
        "theme": "A named preset or light/dark mode shorthand; payload commands take precedence.",
        "themeMode": "Light or dark mode, independently of the selected preset."
      },
      "options": {
        "theme": "Preset or light/dark mode shorthand, accepted as a command, option, options-table row or fence attribute.",
        "themeMode": "Light or dark, accepted as a command, option, options-table row or fence attribute.",
        "heatmapValueName": "Nonblank numeric color measurement name, used as the heatmap key title.",
        "gaugeMinimum": { "type": "number", "default": 0 },
        "gaugeMaximum": { "type": "number", "default": 100 }
      },
      "commandForms": {
        "candle": "candle X_OR_ISO_DATE OPEN HIGH LOW CLOSE",
        "item": "item ID \"LABEL\" [parent=ID] [value=NUMBER] [colorValue=NUMBER]",
        "node": "node ID \"LABEL\"",
        "flow": "flow ID SOURCE TARGET VALUE [colorValue=NUMBER]",
        "typedSeries": "series \"Name\""
      },
      "tableMode": "Numeric data tables retain label/category plus series columns; each numeric column becomes a series (a heatmap row for type heatmap). Gauge charts require exactly one series with one value. Candlestick/OHLC use candles sections with consistently numeric x values or ISO dates (yyyy-MM-dd); dates select the native UTC time axis. Treemap uses items sections with optional parent/value/colorValue; empty parent/value cells preserve root/group items with null values. Sankey and Chord use nodes/flows sections. Typed families have one named series and do not accept numeric series as typed data. A new section changes tables; end returns to chart commands.",
      "validation": "Runtime parsers normalize case and hyphens/underscores and validate native typed models. Editor metadata describes syntax; it does not replace parser diagnostics or native financial, hierarchy, relationship and gauge validation."
    },
    {
      "kind": "timeline",
      "fence": "chartforgex timeline v1",
      "artifactKind": "Timeline",
      "model": "Chart",
      "commands": [
        "id",
        "title",
        "subtitle",
        "type",
        "mode",
        "size",
        "today",
        "item",
        "event",
        "task",
        "milestone"
      ],
      "sections": [
        {
          "name": "items",
          "columns": [
            "kind",
            "label",
            "start",
            "end",
            "progress",
            "dependsOn",
            "color"
          ]
        }
      ],
      "enumValues": {
        "type": [
          "timeline",
          "gantt"
        ]
      }
    },
    {
      "kind": "topology",
      "fence": "chartforgex topology v1",
      "artifactKind": "Topology",
      "model": "TopologyChart",
      "commands": [
        "id",
        "title",
        "subtitle",
        "viewport",
        "layout",
        "group",
        "node",
        "edge"
      ],
      "sections": [
        {
          "name": "groups",
          "columns": [
            "id",
            "label",
            "status",
            "icon"
          ]
        },
        {
          "name": "nodes",
          "columns": [
            "id",
            "label",
            "kind",
            "status",
            "group",
            "subtitle",
            "badge",
            "icon"
          ]
        },
        {
          "name": "edges",
          "columns": [
            "from",
            "to",
            "label",
            "kind",
            "status",
            "direction"
          ]
        }
      ]
    },
    {
      "kind": "flow",
      "fence": "chartforgex flow v1",
      "artifactKind": "Flow",
      "model": "FlowArtifact",
      "commands": [
        "id",
        "title",
        "subtitle",
        "size",
        "layout",
        "direction",
        "lane",
        "step",
        "start",
        "process",
        "decision",
        "end",
        "connector",
        "connect"
      ],
      "sections": [
        {
          "name": "lanes",
          "columns": [
            "id",
            "label",
            "status"
          ]
        },
        {
          "name": "steps",
          "columns": [
            "id",
            "label",
            "kind",
            "lane",
            "status",
            "subtitle",
            "badge"
          ]
        },
        {
          "name": "connectors",
          "columns": [
            "from",
            "to",
            "label",
            "kind",
            "status"
          ]
        }
      ],
      "enumValues": {
        "stepKind": [
          "start",
          "process",
          "decision",
          "end",
          "input",
          "output",
          "data",
          "external",
          "document",
          "manual",
          "delay",
          "event"
        ],
        "direction": [
          "left-to-right",
          "right-to-left",
          "top-to-bottom",
          "bottom-to-top"
        ]
      }
    },
    {
      "kind": "architecture",
      "fence": "chartforgex architecture v1",
      "artifactKind": "Topology",
      "model": "TopologyChart",
      "commands": [
        "title",
        "subtitle",
        "direction",
        "layout",
        "viewport",
        "legend",
        "group",
        "boundary",
        "node",
        "user",
        "service",
        "server",
        "database",
        "storage",
        "queue",
        "gateway",
        "connect",
        "usecase",
        "visit",
        "end"
      ],
      "stepArrows": {
        "->": "request",
        "->>": "message",
        "-->": "response",
        "-x": "failure"
      },
      "payloadFormats": [
        "json",
        "xml",
        "text"
      ],
      "diagnosticCodes": "CFXA001-CFXA015"
    },
    {
      "kind": "sequence",
      "fence": "chartforgex sequence v1",
      "artifactKind": "Sequence",
      "model": "SequenceArtifact",
      "commands": [
        "id",
        "title",
        "subtitle",
        "size",
        "viewport",
        "participant",
        "actor",
        "boundary",
        "control",
        "entity",
        "database",
        "collections",
        "queue",
        "message",
        "msg",
        "note",
        "block"
      ],
      "sections": [
        {
          "name": "participants",
          "columns": [
            "id",
            "label",
            "kind"
          ]
        },
        {
          "name": "messages",
          "columns": [
            "from",
            "to",
            "text",
            "style",
            "activate",
            "deactivate"
          ]
        },
        {
          "name": "notes",
          "columns": [
            "placement",
            "participant",
            "participants",
            "text",
            "step"
          ]
        },
        {
          "name": "blocks",
          "columns": [
