        ],
        "notePlacement": [
          "leftOf",
          "rightOf",
          "over"
        ],
        "blockKind": [
          "loop",
          "alt",
          "opt",
          "par",
          "critical",
          "rect",
          "break"
        ]
      }
    },
    {
      "kind": "table",
      "fence": "chartforgex table v1",
      "artifactKind": "Table",
      "model": "TableArtifact",
      "commands": [
        "id",
        "title",
        "subtitle",
        "capabilities",
        "totalRows"
      ],
      "sections": [
        {
          "name": "columns",
          "columns": [
            "id",
            "label",
            "type",
            "alignment"
          ]
        },
        {
          "name": "rows",
          "columns": [
            "column ids declared in columns"
          ]
        }
      ],
      "enumValues": {
        "capability": [
          "sort",
          "filter",
          "search",
          "select",
          "singleSelection",
          "multiselect",
          "multiSelection",
          "cellselect",
          "cellSelection",
          "copy",
          "export",
          "virtualization"
        ]
      },
      "interactionBoundary": "Static ChartForgeX output renders a deterministic table preview. Production rich table interaction belongs in a future host or adapter package driven by real application requirements."
    }
  ]
}
