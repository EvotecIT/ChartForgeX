<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ChartForgeX.Visuals\ChartForgeX.Visuals.csproj" />
    <ProjectReference Include="..\ChartForgeX.Stories\ChartForgeX.Stories.csproj" />
    <ProjectReference Include="..\ChartForgeX.Mermaid\ChartForgeX.Mermaid.csproj" />
    <ProjectReference Include="..\ChartForgeX\ChartForgeX.csproj" />
    <ProjectReference Include="..\ChartForgeX.Examples.Snippets\ChartForgeX.Examples.Snippets.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="..\ChartForgeX.Interactivity.Html\ChartForgeX.Interactivity.Html.csproj" />
    <ProjectReference Include="..\ChartForgeX.Markup\ChartForgeX.Markup.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\Fonts\Carlito\*" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures\Fonts\IBMPlexSans\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Recipes\*Recipe.cs" LogicalName="ChartForgeX.Examples.Recipes.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="Snippets\RecipeProgram.cs.txt" LogicalName="ChartForgeX.Examples.RecipeProgram.cs" WithCulture="false" />
    <EmbeddedResource Include="Snippets\RecipeChartProgram.cs.txt" LogicalName="ChartForgeX.Examples.RecipeChartProgram.cs" WithCulture="false" />
    <EmbeddedResource Include="Snippets\FiveLineChart.cs.txt" LogicalName="ChartForgeX.Examples.FiveLineChart.cs" WithCulture="false" />
    <EmbeddedResource Include="Assets\styled-multilingual-text.svg" LogicalName="ChartForgeX.Examples.styled-multilingual-text.svg" WithCulture="false" />
    <EmbeddedResource Include="Assets\styled-multilingual-text.html" LogicalName="ChartForgeX.Examples.styled-multilingual-text.html" WithCulture="false" />
    <EmbeddedResource Include="Assets\Gallery\*" LogicalName="ChartForgeX.Examples.Gallery.%(Filename)%(Extension)" WithCulture="false" />
    <!-- These are inert authored source fixtures, not JavaScript/plugin dependencies. -->
    <EmbeddedResource Include="..\tests\mermaid-conformance\fixtures\agentflow-native-workflow.mmd" LogicalName="ChartForgeX.Examples.MermaidFixtures.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\tests\mermaid-conformance\fixtures\state-native-safe-styles.mmd" LogicalName="ChartForgeX.Examples.MermaidFixtures.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\tests\mermaid-conformance\fixtures\state-concurrent-regions.mmd" LogicalName="ChartForgeX.Examples.MermaidFixtures.%(Filename)%(Extension)" WithCulture="false" />
    <EmbeddedResource Include="..\tests\mermaid-conformance\external-plugins\zenuml\zenuml-native-occurrences.mmd" LogicalName="ChartForgeX.Examples.MermaidFixtures.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
