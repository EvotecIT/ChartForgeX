<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InteractivityBenchmarkProfile Condition="'$(InteractivityBenchmarkProfile)' == ''">Acquisition</InteractivityBenchmarkProfile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="InteractivityBenchmarkLane.cs" />
    <Compile Remove="SectionPreparationBenchmarkFixture.cs;CartesianSectionPreparationBenchmarkFixture.cs" Condition="'$(InteractivityBenchmarkProfile)' == 'Acquisition' or '$(InteractivityBenchmarkProfile)' == 'SustainedUpdate'" />
    <Compile Remove="SustainedUpdateBenchmarkFixture.cs;SustainedUpdateBenchmarkFixture.Verification.cs" Condition="'$(InteractivityBenchmarkProfile)' != 'SustainedUpdate'" />
    <Compile Remove="InteractivityBenchmarkFixture.cs" Condition="'$(InteractivityBenchmarkProfile)' != 'Acquisition'" />
    <Compile Remove="CartesianSectionPreparationBenchmarkFixture.cs" Condition="'$(InteractivityBenchmarkProfile)' == 'SectionShared'" />
    <Reference Include="ChartForgeX"><HintPath>$(ProductBinaryRoot)/ChartForgeX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ChartForgeX.Interactivity"><HintPath>$(ProductBinaryRoot)/ChartForgeX.Interactivity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ChartForgeX.Interactivity.Html"><HintPath>$(ProductBinaryRoot)/ChartForgeX.Interactivity.Html.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HtmlTinkerX" Condition="'$(InteractivityBenchmarkProfile)' == 'Acquisition' or '$(InteractivityBenchmarkProfile)' == 'SustainedUpdate'"><HintPath>$(ProductBinaryRoot)/HtmlTinkerX.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Playwright" Condition="'$(InteractivityBenchmarkProfile)' == 'Acquisition' or '$(InteractivityBenchmarkProfile)' == 'SustainedUpdate'"><HintPath>$(ProductBinaryRoot)/Microsoft.Playwright.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(InteractivityBenchmarkProfile)' == 'Acquisition' or '$(InteractivityBenchmarkProfile)' == 'SustainedUpdate'"><HintPath>$(ProductBinaryRoot)/Microsoft.Bcl.AsyncInterfaces.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateInteractivityBenchmarkProfile" BeforeTargets="CoreCompile">
    <Error Condition="'$(InteractivityBenchmarkProfile)' != 'Acquisition' and '$(InteractivityBenchmarkProfile)' != 'SectionShared' and '$(InteractivityBenchmarkProfile)' != 'SectionCurrent' and '$(InteractivityBenchmarkProfile)' != 'SustainedUpdate'" Text="InteractivityBenchmarkProfile must be Acquisition, SectionShared, SectionCurrent or SustainedUpdate." />
  </Target>
</Project>
