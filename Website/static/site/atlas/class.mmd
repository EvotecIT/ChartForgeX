classDiagram
  class Chart {
    +string Title
    +WithSize(width, height)
    +ToSvg() string
  }
  class ChartSeries {
    +string Name
    +ChartPoint[] Points
  }
  class ChartTheme {
    +string FontFamily
  }
  Chart "1" *-- "many" ChartSeries : contains
  Chart --> ChartTheme : uses
