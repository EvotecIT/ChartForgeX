<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Desktop check for the playground engine: compiles the same engine sources as Website/tools/Playground
    and renders every bundled sample in both themes. Run by Website/config/presets/pipeline.playground.json
    so a renderer change that breaks a sample fails the site build instead of shipping a broken playground.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Playground\PlaygroundEngine.cs" Link="Engine\PlaygroundEngine.cs" />
    <Compile Include="..\Playground\PlaygroundEngine.Png.cs" Link="Engine\PlaygroundEngine.Png.cs" />
    <Compile Include="..\Playground\PlaygroundEngine.Fonts.cs" Link="Engine\PlaygroundEngine.Fonts.cs" />
    <Compile Include="..\Playground\PlaygroundJson.cs" Link="Engine\PlaygroundJson.cs" />
    <Compile Include="..\Playground\PlaygroundSamples.cs" Link="Engine\PlaygroundSamples.cs" />
    <Compile Include="..\Playground\PlaygroundFonts.cs" Link="Engine\PlaygroundFonts.cs" />
    <EmbeddedResource Include="..\..\..\ChartForgeX.Examples\Fixtures\Fonts\Carlito\Carlito-Regular.ttf" LogicalName="Fonts.Carlito-Regular.ttf" />
    <EmbeddedResource Include="..\..\..\ChartForgeX.Examples\Fixtures\Fonts\Carlito\Carlito-Bold.ttf" LogicalName="Fonts.Carlito-Bold.ttf" />
    <EmbeddedResource Include="..\..\..\ChartForgeX.Examples\Fixtures\Fonts\Carlito\OFL.txt" LogicalName="Fonts.Carlito-OFL.txt" />
    <!-- Desktop-check source text only; these do not enter the Playground/WASM project. -->
    <EmbeddedResource Include="..\..\..\tests\mermaid-conformance\fixtures\agentflow-native-workflow.mmd" LogicalName="PlaygroundCheck.MermaidFixtures.agentflow-native-workflow.mmd" WithCulture="false" />
    <EmbeddedResource Include="..\..\..\tests\mermaid-conformance\external-plugins\zenuml\zenuml-native-occurrences.mmd" LogicalName="PlaygroundCheck.MermaidFixtures.zenuml-native-occurrences.mmd" WithCulture="false" />
    <EmbeddedResource Include="..\..\..\tests\mermaid-conformance\fixtures\railroad-ir-native.mmd" LogicalName="PlaygroundCheck.MermaidFixtures.railroad-ir-native.mmd" WithCulture="false" />
    <EmbeddedResource Include="..\..\..\tests\mermaid-conformance\fixtures\railroad-ebnf-native.mmd" LogicalName="PlaygroundCheck.MermaidFixtures.railroad-ebnf-native.mmd" WithCulture="false" />
    <EmbeddedResource Include="..\..\..\tests\mermaid-conformance\fixtures\railroad-abnf-native.mmd" LogicalName="PlaygroundCheck.MermaidFixtures.railroad-abnf-native.mmd" WithCulture="false" />
    <EmbeddedResource Include="Fixtures\railroad-abnf-case-sensitive.mmd" LogicalName="PlaygroundCheck.MermaidFixtures.railroad-abnf-case-sensitive.mmd" WithCulture="false" />
    <EmbeddedResource Include="..\..\..\tests\mermaid-conformance\fixtures\railroad-peg-native.mmd" LogicalName="PlaygroundCheck.MermaidFixtures.railroad-peg-native.mmd" WithCulture="false" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\ChartForgeX\ChartForgeX.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Markup\ChartForgeX.Markup.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Mermaid\ChartForgeX.Mermaid.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Markup.Mermaid\ChartForgeX.Markup.Mermaid.csproj" />
  </ItemGroup>
</Project>
