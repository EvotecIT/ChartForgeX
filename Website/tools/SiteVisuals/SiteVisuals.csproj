<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the chartforgex.com hero, surface, Mermaid, navigation, docs and example visuals with ChartForgeX itself. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The playground samples are Mermaid atlas sources, so the atlas and the playground show the same text. -->
    <Compile Include="..\Playground\PlaygroundEngine.cs" Link="Playground\PlaygroundEngine.cs" />
    <Compile Include="..\Playground\PlaygroundJson.cs" Link="Playground\PlaygroundJson.cs" />
    <Compile Include="..\Playground\PlaygroundSamples.cs" Link="Playground\PlaygroundSamples.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\ChartForgeX\ChartForgeX.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Visuals\ChartForgeX.Visuals.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Stories\ChartForgeX.Stories.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Markup\ChartForgeX.Markup.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Mermaid\ChartForgeX.Mermaid.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Markup.Mermaid\ChartForgeX.Markup.Mermaid.csproj" />
    <ProjectReference Include="..\..\..\ChartForgeX.Interactivity.Html\ChartForgeX.Interactivity.Html.csproj" />
  </ItemGroup>
</Project>
