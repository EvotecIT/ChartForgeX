      "figures": [
        {
          "id": "hierarchy-treemap-full",
          "title": "Full Treemap",
          "caption": "The complete Treemap uses the shared allocation facts."
        },
        {
          "id": "hierarchy-treemap-engineering",
          "title": "Engineering Treemap",
          "caption": "Engineering becomes the visible Treemap root; original leaf identities and sizes remain."
        },
        {
          "id": "hierarchy-sunburst-full",
          "title": "Full Sunburst",
          "caption": "The complete Sunburst uses explicit sector spacing and a primary-caption fitting floor."
        },
        {
          "id": "hierarchy-sunburst-engineering",
          "title": "Engineering Sunburst",
          "caption": "The same Engineering subtree rebases its native rings without changing the original parent links."
        }
      ]
    },
    {
      "url": "/docs/api-conventions/",
      "id": "native-axis-examples",
      "title": "Native axis examples",
      "summary": "The complete program produces these SVG and native PNG files from explicit signed logarithmic and time-spacing policies.",
      "recipe": "native-axis",
      "figures": [
        {
          "id": "axis-positive-log",
          "title": "Positive logarithmic domain",
          "caption": "Positive source values use base-two logarithmic spacing."
        },
        {
          "id": "axis-negative-log",
          "title": "Negative logarithmic domain",
          "caption": "Negative source values retain their signs on an explicit negative logarithmic domain."
        },
        {
          "id": "axis-ordinal",
          "title": "Ordinal observations",
          "caption": "The supplied January and March observations occupy adjacent ordinal slots."
        },
        {
          "id": "axis-calendar-month",
          "title": "Calendar-month bands",
          "caption": "The same raw UTC instants retain an empty February calendar band."
        }
      ]
    }
