    {
      "url": "/docs/topology-and-hierarchy/",
      "id": "native-area-hierarchy-examples",
      "title": "Native full and subtree views",
      "summary": "These four views reuse the same source item IDs, parent links and leaf sizes. The complete program prepares each full hierarchy and the Engineering subtree without replacing source data.",
