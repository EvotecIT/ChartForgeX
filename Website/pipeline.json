{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.web.pipelinespec.schema.json",
  "extends": "./config/presets/pipeline.web-quality.json",
  "steps": [
    {
      "task": "llms",
      "id": "build-llms",
      "dependsOn": "build-site",
      "siteRoot": "./_site",
      "name": "ChartForgeX",
      "packageId": "ChartForgeX",
      "license": "MIT",
      "targets": ".NET Framework 4.7.2, .NET Standard 2.0, .NET 8, .NET 10"
    },
    {
      "task": "optimize",
      "id": "optimize-site",
      "dependsOn": "build-site",
      "modes": ["ci"],
      "siteRoot": "./_site",
      "config": "./site.json",
      "criticalCss": "./themes/chartforgex/critical.css",
      "minifyHtml": true,
      "minifyCss": true,
      "minifyJs": true,
      "optimizeImages": true,
      "imageInclude": ["powerbginfo/**"],
      "imageGenerateWebp": true,
      "imagePreferNextGen": true,
      "imageWidths": [480, 960, 1440],
      "imageQuality": 86,
      "imageFailOnFailures": true
    },
    {
      "task": "exec",
      "id": "playground-samples-check",
      "command": "dotnet",
      "argsList": ["run", "--project", "./tools/PlaygroundCheck/PlaygroundCheck.csproj", "-c", "Release"],
      "workingDirectory": ".",
      "timeoutSeconds": 900
    },
    {
      "task": "dotnet-publish",
      "id": "playground-engine-publish",
      "project": "./tools/Playground/ChartForgeX.Playground.Engine.csproj",
      "out": "./_temp/playground-engine",
      "configuration": "Release",
      "clean": true,
      "blazorFixes": false
    },
    {
      "task": "overlay",
      "id": "playground-engine-overlay",
      "source": "./_temp/playground-engine/wwwroot",
      "destination": "./_site/playground/engine",
      "include": "_framework/**",
      "clean": true
    }
  ]
}
