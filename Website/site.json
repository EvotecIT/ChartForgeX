{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.web.sitespec.schema.json",
  "SchemaVersion": 1,
  "Name": "ChartForgeX",
  "BaseUrl": "https://chartforgex.com",
  "DefaultTheme": "chartforgex",
  "ThemeEngine": "scriban",
  "Features": [
    "docs",
    "notFound"
  ],
  "TrailingSlash": "always",
  "ContentRoot": "content",
  "ThemesRoot": "themes",
  "DataRoot": "data",
  "StaticAssets": [
    {
      "Source": "static"
    }
  ],
  "Collections": [
    {
      "Name": "pages",
      "Input": "content/pages",
      "Output": "/",
      "DefaultLayout": "page",
      "UseToc": false,
      "Include": [
        "*.md",
        "**/*.md"
      ],
      "Seo": {
        "Templates": {
          "Title": "{title} | {site}"
        }
      }
    },
    {
      "Name": "docs",
      "Input": "content/project-docs/docs",
      "Output": "/docs",
      "DefaultLayout": "docs",
      "UseToc": false,
      "Include": [
        "*.md",
        "**/*.md"
      ],
      "Seo": {
        "Templates": {
          "Title": "{title} | {site} documentation"
        }
      }
    },
    {
      "Name": "examples",
      "Input": "content/examples",
      "Output": "/examples",
      "DefaultLayout": "docs",
      "UseToc": false,
      "Include": [
        "*.md",
        "**/*.md"
      ],
      "Seo": {
        "Templates": {
          "Title": "{title} | {site}"
        }
      }
    }
  ],
  "Head": {
    "Links": [
      {
        "Rel": "icon",
        "Href": "/favicon.svg",
        "Type": "image/svg+xml"
      },
      {
        "Rel": "apple-touch-icon",
        "Href": "/apple-touch-icon.png"
      },
      {
        "Rel": "preload",
        "Href": "/fonts/archivo-latin.woff2",
        "As": "font",
        "Type": "font/woff2",
        "Crossorigin": "anonymous"
      }
    ],
    "Meta": [
      {
        "Name": "robots",
        "Content": "index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1"
      },
      {
        "Name": "theme-color",
        "Content": "#f2f3f4"
      }
    ]
  },
  "Social": {
    "Enabled": true,
    "SiteName": "ChartForgeX",
    "Image": "/site/social-card.png",
    "TwitterCard": "summary_large_image"
  },
  "AgentReadiness": {
    "Enabled": true,
    "HeadersPath": "_headers",
    "LinkHeaders": true,
    "Robots": true,
    "SecurityHeaders": {
      "Enabled": true,
      "ContentSecurityPolicyValue": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
    },
    "ContentSignals": {
      "Enabled": true,
      "Search": true,
      "AiInput": true,
      "AiTrain": false
    },
    "AgentSkills": {
      "Enabled": true,
      "Skills": [
        {
          "Name": "chartforgex-site-assistant",
          "Type": "skill-md",
          "Description": "Use ChartForgeX documentation, gallery, sitemap, and llms files.",
          "Content": "---\nname: chartforgex-site-assistant\ndescription: Use ChartForgeX documentation, gallery, sitemap, and llms resources.\n---\n\n# ChartForgeX Site Assistant\n\nUse this skill when answering questions about ChartForgeX.\n\n- Prefer canonical pages from https://chartforgex.com.\n- Use `/docs/` for product and workflow guidance and `/gallery/` for rendered examples with C# source.\n- Use `/mermaid/` for Mermaid support status; do not claim complete Mermaid compatibility.\n- Check `/llms.txt` when present for an agent-readable summary.\n- Respect `/robots.txt` and Content-Signal preferences.\n"
        }
      ]
    },
    "MarkdownNegotiation": true
  },
  "EditLinks": {
    "Enabled": true,
    "Template": "https://github.com/EvotecIT/ChartForgeX/edit/main/Website/{path}"
  },
  "AssetRegistry": {
    "CssStrategy": "blocking",
    "Bundles": [
      {
        "Name": "global",
        "Css": [
          "/themes/chartforgex/assets/base.css"
        ],
        "Js": [
          "/themes/chartforgex/assets/site.js"
        ]
      },
      {
        "Name": "home",
        "Css": [
          "/site/hero-theme.css",
          "/themes/chartforgex/assets/home.css"
        ]
      },
      {
        "Name": "gallery",
        "Css": [
          "/themes/chartforgex/assets/gallery.css"
        ]
      },
      {
        "Name": "docs",
        "Css": [
          "/themes/chartforgex/assets/docs.css"
        ]
      }
    ],
    "RouteBundles": [
      {
        "Match": "/**",
        "Bundles": [
          "global"
        ]
      },
      {
        "Match": "/",
        "Bundles": [
          "home",
          "gallery"
        ]
      },
      {
        "Match": "/gallery/**",
        "Bundles": [
          "gallery"
        ]
      },
      {
        "Match": "/mermaid/**",
        "Bundles": [
          "docs",
          "home"
        ]
      },
      {
        "Match": "/docs/**",
        "Bundles": [
          "docs"
        ]
      },
      {
        "Match": "/examples/**",
        "Bundles": [
          "docs"
        ]
      }
    ],
    "CriticalCss": [
      {
        "Name": "chartforgex",
        "Path": "themes/chartforgex/critical.css"
      }
    ]
  },
  "Prism": {
    "Mode": "auto",
    "Source": "local",
    "DefaultLanguage": "csharp",
    "Local": {
      "ThemeLight": "/assets/prism/prism-cfx.css",
      "ThemeDark": "/assets/prism/prism-cfx.css"
    }
  },
  "A11y": {
    "SkipLinkLabel": "Skip to content",
    "ExternalLinkLabel": "Opens in a new tab",
    "NavToggleLabel": "Toggle navigation",
    "SearchLabel": "Search"
  },
  "LinkRules": {
    "ExternalRel": "noopener",
    "ExternalTarget": "_blank",
    "AddExternalIcon": false
  },
  "Navigation": {
    "Auto": [
      {
        "Collection": "docs",
        "Menu": "docs",
        "MaxDepth": 2,
        "IncludeIndex": true,
        "IncludeDrafts": false
      },
      {
        "Collection": "examples",
        "Menu": "examples",
        "MaxDepth": 2,
        "IncludeIndex": true,
        "IncludeDrafts": false
      }
    ],
    "Surfaces": [
      {
        "Name": "main",
        "Path": "/",
        "PrimaryMenu": "main"
      },
      {
        "Name": "docs",
        "Path": "/docs/",
        "Collection": "docs",
        "Layout": "docs",
        "PrimaryMenu": "main"
      },
      {
        "Name": "notFound",
        "Path": "/404/",
        "PrimaryMenu": "main"
      }
    ],
    "Menus": [
      {
        "Name": "main",
        "Items": [
          {
            "Title": "Home",
            "Url": "/"
          },
          {
            "Title": "Gallery",
            "Url": "/gallery/"
          },
          {
            "Title": "Mermaid",
            "Url": "/mermaid/"
          },
          {
            "Title": "Docs",
            "Url": "/docs/"
          },
          {
            "Title": "Examples",
            "Url": "/examples/"
          }
        ]
      },
      {
        "Name": "footer-product",
        "Items": [
          {
            "Title": "Gallery",
            "Url": "/gallery/"
          },
          {
            "Title": "Mermaid support",
            "Url": "/mermaid/"
          },
          {
            "Title": "Documentation",
            "Url": "/docs/"
          },
          {
            "Title": "Examples",
            "Url": "/examples/"
          }
        ]
      },
      {
        "Name": "footer-resources",
        "Items": [
          {
            "Title": "NuGet packages",
            "Url": "https://www.nuget.org/packages?q=ChartForgeX",
            "External": true
          },
          {
            "Title": "Source on GitHub",
            "Url": "https://github.com/EvotecIT/ChartForgeX",
            "External": true
          },
          {
            "Title": "Releases",
            "Url": "https://github.com/EvotecIT/ChartForgeX/releases",
            "External": true
          },
          {
            "Title": "Report an issue",
            "Url": "https://github.com/EvotecIT/ChartForgeX/issues",
            "External": true
          }
        ]
      },
      {
        "Name": "footer-company",
        "Items": [
          {
            "Title": "Evotec",
            "Url": "https://evotec.xyz/",
            "External": true
          },
          {
            "Title": "All products",
            "Url": "https://evotec.xyz/products/",
            "External": true
          },
          {
            "Title": "Privacy notice",
            "Url": "https://evotec.xyz/privacy-notice/",
            "External": true
          }
        ]
      }
    ],
    "Actions": [
      {
        "Title": "ChartForgeX on GitHub",
        "Url": "https://github.com/EvotecIT/ChartForgeX",
        "External": true,
        "CssClass": "cfx-icon-link",
        "AriaLabel": "ChartForgeX on GitHub",
        "IconHtml": "<svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" aria-hidden=\"true\" fill=\"currentColor\"><path d=\"M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z\"/></svg>"
      },
      {
        "Title": "Install",
        "Url": "/docs/install/",
        "CssClass": "cfx-btn cfx-btn--small"
      }
    ]
  }
}
