{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.web.pipelinespec.schema.json",
  "cache": true,
  "cachePath": "./.powerforge/pipeline-cache.json",
  "profile": true,
  "profilePath": "./_reports/pipeline-profile.json",
  "steps": [
    {
      "task": "engine-lock",
      "id": "engine-lock-ci",
      "modes": [
        "ci"
      ],
      "operation": "verify",
      "path": "./.powerforge/engine-lock.json",
      "failOnDrift": true,
      "requireImmutableRef": true,
      "reportPath": "./_reports/engine-lock.json",
      "summaryPath": "./_reports/engine-lock.md"
    },
    {
      "task": "build",
      "id": "build-site",
      "config": "./site.json",
      "out": "./_site",
      "clean": true
    },
    {
      "task": "exec",
      "id": "api-chrome",
      "dependsOn": "build-site",
      "command": "pwsh",
      "argsList": ["-NoProfile", "-File", "./build/Export-ApiChrome.ps1"],
      "workingDirectory": ".",
      "timeoutSeconds": 120
    },
    {
      "task": "dotnet-build",
      "id": "api-build-chartforgex-visuals",
      "project": "../ChartForgeX.Visuals/ChartForgeX.Visuals.csproj",
      "configuration": "Release",
      "framework": "net10.0"
    },
    {
      "task": "dotnet-build",
      "id": "api-build-chartforgex-stories",
      "project": "../ChartForgeX.Stories/ChartForgeX.Stories.csproj",
      "configuration": "Release",
      "framework": "net10.0"
    },
    {
      "task": "dotnet-build",
      "id": "api-build-chartforgex-interactivity-html",
      "project": "../ChartForgeX.Interactivity.Html/ChartForgeX.Interactivity.Html.csproj",
      "configuration": "Release",
      "framework": "net10.0"
    },
    {
      "task": "dotnet-build",
      "id": "api-build-chartforgex-markup-mermaid",
      "project": "../ChartForgeX.Markup.Mermaid/ChartForgeX.Markup.Mermaid.csproj",
      "configuration": "Release",
      "framework": "net10.0"
    },
    {
      "task": "apidocs",
      "id": "build-apidocs",
      "dependsOn": [
        "build-site",
        "api-chrome",
        "api-build-chartforgex-visuals",
        "api-build-chartforgex-stories",
        "api-build-chartforgex-interactivity-html",
        "api-build-chartforgex-markup-mermaid"
      ],
      "config": "./site.json",
      "assemblies": [
        "../ChartForgeX/bin/Release/net10.0/ChartForgeX.dll",
        "../ChartForgeX.Visuals/bin/Release/net10.0/ChartForgeX.Visuals.dll",
        "../ChartForgeX.Stories/bin/Release/net10.0/ChartForgeX.Stories.dll",
        "../ChartForgeX.Interactivity/bin/Release/net10.0/ChartForgeX.Interactivity.dll",
        "../ChartForgeX.Interactivity.Html/bin/Release/net10.0/ChartForgeX.Interactivity.Html.dll",
        "../ChartForgeX.Markup/bin/Release/net10.0/ChartForgeX.Markup.dll",
        "../ChartForgeX.Mermaid/bin/Release/net10.0/ChartForgeX.Mermaid.dll",
        "../ChartForgeX.Markup.Mermaid/bin/Release/net10.0/ChartForgeX.Markup.Mermaid.dll"
      ],
      "xmls": [
        "../ChartForgeX/bin/Release/net10.0/ChartForgeX.xml",
        "../ChartForgeX.Visuals/bin/Release/net10.0/ChartForgeX.Visuals.xml",
        "../ChartForgeX.Stories/bin/Release/net10.0/ChartForgeX.Stories.xml",
        "../ChartForgeX.Interactivity/bin/Release/net10.0/ChartForgeX.Interactivity.xml",
        "../ChartForgeX.Interactivity.Html/bin/Release/net10.0/ChartForgeX.Interactivity.Html.xml",
        "../ChartForgeX.Markup/bin/Release/net10.0/ChartForgeX.Markup.xml",
        "../ChartForgeX.Mermaid/bin/Release/net10.0/ChartForgeX.Mermaid.xml",
        "../ChartForgeX.Markup.Mermaid/bin/Release/net10.0/ChartForgeX.Markup.Mermaid.xml"
      ],
      "out": "./_site/api",
      "title": "ChartForgeX API reference",
      "baseUrl": "/api",
      "format": "both",
      "template": "docs",
      "css": "/themes/chartforgex/assets/tokens.css,/themes/chartforgex/assets/base.css,/themes/chartforgex/assets/nav.css,/themes/chartforgex/assets/api-base.css,/themes/chartforgex/assets/api.css",
      "sourceRoot": "..",
      "sourceUrl": "https://github.com/EvotecIT/ChartForgeX/blob/main/{root}/{pathNoRoot}#L{line}",
      "includeNamespace": "ChartForgeX",
      "quickStartTypes": "Chart,ChartGrid,ChartTable,TopologyChart,MermaidRenderer,VisualStory",
      "relatedContentManifest": "./config/api-related-content.json",
      "coverageReport": "./_reports/apidocs-coverage.json",
      "injectCriticalCss": true,
      "criticalCssPath": "./themes/chartforgex/critical.css",
      "templateDocsIndex": "./themes/chartforgex/apidocs/docs-index.html",
      "templateDocsType": "./themes/chartforgex/apidocs/docs-type.html",
      "headerHtml": "./_temp/chrome/api-header.html",
      "footerHtml": "./_temp/chrome/api-footer.html"
    },
    {
      "task": "apidocs",
      "id": "build-powershell-commands",
      "dependsOn": ["build-site", "api-chrome"],
      "type": "PowerShell",
      "config": "./site.json",
      "help": "./powershell/imageplayground-help.xml",
      "out": "./_site/powershell/commands",
      "baseUrl": "/powershell/commands",
      "title": "ImagePlayground commands for ChartForgeX",
      "format": "both",
      "template": "docs",
      "css": "/themes/chartforgex/assets/tokens.css,/themes/chartforgex/assets/base.css,/themes/chartforgex/assets/nav.css,/themes/chartforgex/assets/api-base.css,/themes/chartforgex/assets/api.css",
      "injectCriticalCss": true,
      "criticalCssPath": "./themes/chartforgex/critical.css",
      "templateDocsIndex": "./themes/chartforgex/apidocs/docs-index.html",
      "templateDocsType": "./themes/chartforgex/apidocs/docs-type.html",
      "headerHtml": "./_temp/chrome/powershell-commands-header.html",
      "footerHtml": "./_temp/chrome/powershell-commands-footer.html"
    },
    {
      "task": "seo-doctor",
      "id": "seo-doctor-ci",
      "dependsOn": "build-site",
      "modes": [
        "ci"
      ],
      "siteRoot": "./_site",
      "baseline": "./.powerforge/seo-baseline.json",
      "failOnNewIssues": true,
      "checkContentLeaks": true,
      "requireCanonical": true,
      "requireHreflang": false,
      "requireHreflangXDefault": false,
      "reportPath": "./_reports/seo-doctor.json",
      "summaryPath": "./_reports/seo-doctor.md",
      "exclude": "examples/generated/**,site/**,playground/engine/**,powershell/examples/**"
    },
    {
      "task": "sitemap",
      "id": "sitemap",
      "dependsOn": ["build-site", "build-apidocs", "build-powershell-commands"],
      "config": "./site.json",
      "siteRoot": "./_site",
      "baseUrl": "https://chartforgex.com",
      "json": true,
      "jsonOut": "./_site/sitemap/index.json",
      "excludePatterns": [
        "examples/generated/**",
        "site/**",
        "playground/engine/**",
        "powershell/examples/**"
      ]
    },
    {
      "task": "indexnow",
      "id": "indexnow-ci",
      "dependsOn": "sitemap",
      "modes": [
        "ci"
      ],
      "sitemap": "./_site/sitemap.xml",
      "keyEnv": "INDEXNOW_KEY",
      "optionalKey": true,
      "continueOnError": true,
      "reportPath": "./_reports/indexnow.json",
      "summaryPath": "./_reports/indexnow.md"
    },
    {
      "task": "github-artifacts-prune",
      "id": "github-artifacts-hygiene-ci",
      "modes": [
        "ci"
      ],
      "tokenEnv": "GITHUB_TOKEN",
      "optional": true,
      "dryRun": true,
      "reportPath": "./_reports/github-artifacts.json",
      "summaryPath": "./_reports/github-artifacts.md"
    },
    {
      "task": "verify",
      "id": "verify-dev",
      "dependsOn": "build-site",
      "config": "./site.json",
      "siteRoot": "./_site",
      "skipModes": [
        "ci"
      ],
      "warningPreviewCount": 5,
      "errorPreviewCount": 5
    },
    {
      "task": "verify",
      "id": "verify-ci",
      "dependsOn": "build-site",
      "config": "./site.json",
      "siteRoot": "./_site",
      "modes": [
        "ci"
      ],
      "baseline": "./.powerforge/verify-baseline.json",
      "failOnNewWarnings": true,
      "failOnNavLint": true,
      "failOnThemeContract": true,
      "warningPreviewCount": 10,
      "errorPreviewCount": 10
    },
    {
      "task": "audit",
      "id": "audit-ci",
      "dependsOn": "build-site",
      "siteRoot": "./_site",
      "modes": [
        "ci"
      ],
      "summary": true,
      "sarif": true,
      "baseline": "./.powerforge/audit-baseline.json",
      "failOnNewIssues": true,
      "requiredRoutes": "/404.html,/",
      "requireExplicitChecks": true,
      "checkSeoMeta": false,
      "checkNetworkHints": true,
      "checkRenderBlockingResources": true,
      "checkHeadingOrder": true,
      "checkLinkPurposeConsistency": true,
      "checkMediaEmbeds": true,
      "checkAgentContentSecurity": false,
      "rendered": false,
      "renderedMaxPages": 2,
      "renderedEnsureInstalled": true,
      "renderedInclude": "index.html,404.html",
      "exclude": "examples/generated/**,site/**,playground/engine/**,powershell/examples/**"
    }
  ]
}
