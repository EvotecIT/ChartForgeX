{
  "$schema": "https://raw.githubusercontent.com/EvotecIT/PSPublishModule/main/Schemas/powerforge.web.themespec.schema.json",
  "name": "chartforgex",
  "schemaVersion": 2,
  "engine": "scriban",
  "defaultLayout": "page",
  "layoutsPath": "layouts",
  "partialsPath": "partials",
  "assetsPath": "assets",
  "scriptsPath": "assets",
  "slots": {
    "site-header": "header",
    "site-footer": "footer",
    "theme-tokens": "theme-tokens",
    "docs-sidebar": "docs-sidebar"
  },
  "tokens": {
    "color": {
      "page": "#f2f3f4",
      "card": "#ffffff",
      "ink": "#16181c",
      "accent": "#11776f",
      "signal": "#c78404"
    },
    "font": {
      "body": "Archivo, system-ui, sans-serif",
      "mono": "JetBrains Mono, Cascadia Code, Consolas, monospace"
    },
    "layout": {
      "maxWidth": "1240px"
    }
  },
  "features": ["docs", "notFound"],
  "featureContracts": {
    "docs": {
      "requiredLayouts": ["docs"],
      "requiredPartials": ["docs-sidebar"],
      "requiredSlots": [],
      "requiredSurfaces": ["docs"],
      "cssHrefs": ["/themes/chartforgex/assets/docs.css"],
      "requiredCssSelectors": [".cfx-docs", ".cfx-docs__nav", ".cfx-prose"]
    }
  }
}
